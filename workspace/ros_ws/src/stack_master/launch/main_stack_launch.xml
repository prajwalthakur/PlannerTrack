<?xml version="1.0"?>
<launch>

<!-- Static transform from world to map based on yaml origin -->

    <arg name="drive_topic" default="/drive" />

    <arg name="throttle_command_topic" default="/autodrive/roboracer_1/throttle_command" />
    <arg name="steering_command_topic" default="/autodrive/roboracer_1/steering_command" />

    <arg name="left_encoder_topic" default="/autodrive/roboracer_1/left_encoder" />
    <arg name="right_encoder_topic" default="/autodrive/roboracer_1/right_encoder" />
    <arg name="steering_feedback_topic" default="/autodrive/roboracer_1/steering" />


     <!-- CHANGE : Required by the frenet republisher,state-machine,controller.-->
     <!-- localisation pose should subscribed by state_estimation.carstate_node.py, catstae_node also takes odom values from odom-ekf -->
     <arg name="car_state_odom_topic" default="/car_state/odom" />   <!--this will be used by planner,controlller, everything after localisation-->
     <!-- CHANGE to false during deployment (ie while submitting the docker for comp.)-->
     <arg name="vis_rviz" default="true" description="Enable RViz" />       

    <!-- Exposed arguments -->
    <arg name="racecar_version" default="SIM" description="'SIM' / 'NUCx'" />
    <arg name="map_name" default="roboracer_r1" description="Map name in stack_master/maps" />
    <arg name="sim" default="False" description="True/False if you want to run simulation" />
    <arg name="loc_algorithm" default="amcl" description="'slam' / 'amcl' to switch localisation algorithm" />
    <arg name="publish_markers" default="true" description="Enable publishing of visualization markers" />
    <arg name="publish_shortest_path" default="true" description="Enable publishing of shortest path" />
    <arg name="publish_centerline" default="false" description="Enable publishing of centerline" />
    <arg name="publish_lattice" default="false" description="Enable publishing of lattice" />
    
    <!-- ===================================== -->
    <!-- Include bridge launch file -->
    <!-- ===================================== -->

    <include file="$(find-pkg-share autodrive_bridge)/launch/bridge_launch.xml">
        <arg name="drive_topic" value="$(var drive_topic)" />
        <arg name="throttle_command_topic" value="$(var throttle_command_topic)" />
        <arg name="steering_command_topic" value="$(var steering_command_topic)" />
        <arg name="left_encoder_topic" value="$(var left_encoder_topic)" />
        <arg name="right_encoder_topic" value="$(var right_encoder_topic)" />
        <arg name="steering_feedback_topic" value="$(var steering_feedback_topic)" />
    </include>   
    
    <!-- ===================================== -->
    <!-- Include localization launch file -->
    <!-- ===================================== -->
    
    <include file="$(find-pkg-share roboracer_navigation)/launch/localization.launch.py">
        <arg name="localization_mode" value="$(var loc_algorithm)" />
        <arg name="map" value="$(find-pkg-share roboracer_navigation)/maps/$(var map_name).yaml" />
    </include>
    
    <node name="initial_pose_publisher" pkg="roboracer_navigation" exec="initial_pose_publisher" args="" output='screen'>
    </node>
    <!-- ===================================== -->
    <!-- Include base launch  file -->
    <!-- ===================================== -->

    <arg name="frenet" default="True"/>
    <!-- Base system -->
    <include file="$(find-pkg-share stack_master)/launch/base_system_launch.xml">
        <arg name="racecar_version" value="$(var racecar_version)" />
        <arg name="map_name" value="$(var map_name)" />
        <arg name="sim" value="$(var sim)" />
        <arg name="loc_algorithm" value="$(var loc_algorithm)" />
        <arg name="publish_markers" value="$(var publish_markers)" />
        <arg name="publish_shortest_path" value="$(var publish_shortest_path)" />
        <arg name="publish_centerline" value="$(var publish_centerline)" />
        <arg name="publish_lattice" value="$(var publish_lattice)" />
    </include>

    
    <!-- Subscriber topics -->

     <arg name="global_waypoints_topic"
         default="/global_waypoints_scaled" />
    <arg name="car_state_frenet_topic"
         default="/car_state/frenet/odom" />
    
    <arg name="car_state_frenet_pose_topic"
         default="/car_state/frenet/pose" />
    
    <arg name="car_pose_topic"
         default="/car_state/pose" />

    <arg name="avoidance_waypoints_topic"
         default="/planner/avoidance/otwpnts" />

    <arg name="obstacles_topic"
         default="/perception/obstacles" />

    <!-- Publisher topics -->
    <arg name="state_topic"
         default="state" />

    <arg name="state_marker_topic"
         default="state_marker" />

    <arg name="local_waypoints_topic"
         default="local_waypoints" />

    <arg name="local_waypoints_markers_topic"
         default="local_waypoints/markers" />


    <!-- launch frenet odom republisher -->
    <group if="$(var frenet)">
        <include file="$(find-pkg-share frenet_odom_republisher)/launch/frenet_odom_republisher_launch.xml" >
            <arg name="global_waypoints_topic" value="$(var global_waypoints_topic)" />
            <arg name="car_state_odom_topic" value="$(var car_state_odom_topic)" />
            <arg name="car_state_frenet_topic" value="$(var car_state_frenet_topic)" />
            <arg name="car_state_frenet_pose_topic" value="$(var car_state_frenet_pose_topic)" />
        </include>
    </group>

    <!-- Time trials -->
    
    <include file="$(find-pkg-share stack_master)/launch/time_trials_launch.xml">

        <arg name="mode"
             value="timetrials" />

        <arg name="overtake_mode"
             value="dummy" />

        <!-- Subscriber topics -->
        <arg name="global_waypoints_topic"
             value="$(var global_waypoints_topic)" />

        <arg name="car_state_frenet_topic"
             value="$(var car_state_frenet_topic)" />

        <arg name="car_pose_topic"
             value="$(var car_pose_topic)" />

        <arg name="car_state_odom_topic"
             value="$(var car_state_odom_topic)" />

        <arg name="avoidance_waypoints_topic"
             value="$(var avoidance_waypoints_topic)" />

        <arg name="obstacles_topic"
             value="$(var obstacles_topic)" />

        <!-- Publisher topics -->
        <arg name="state_topic"
             value="$(var state_topic)" />

        <arg name="state_marker_topic"
             value="$(var state_marker_topic)" />

        <arg name="local_waypoints_topic"
             value="$(var local_waypoints_topic)" />

        <arg name="local_waypoints_markers_topic"
             value="$(var local_waypoints_markers_topic)" />
    </include>

    <!-- Optional RViz config path -->
    <let name="rviz_config"
        value="$(find-pkg-share stack_master)/config/$(var racecar_version)/sim.rviz" />
    <!-- Launch RViz only if vis_rviz=true -->
    <group if="$(var vis_rviz)">
        <node pkg="rviz2"
              exec="rviz2"
              name="rviz2"
              output="screen"
              args="-d $(var rviz_config)">
            <param name="use_sim_time" value="$(var use_sim_time)" />
        </node>
    </group>
</launch>