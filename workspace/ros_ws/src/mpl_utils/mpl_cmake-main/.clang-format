# This file is automatically synced from:
# https://github.com/autowarefoundation/sync-file-templates
# To make changes, update the source repository and follow the guidelines in its README.

# Modified from https://github.com/ament/ament_lint/blob/master/ament_clang_format/ament_clang_format/configuration/.clang-format
Language: Cpp
BasedOnStyle: Google

# --- Tabs ---
UseTab: ForIndentation   # safer than Always
IndentWidth: 4
TabWidth: 4
ContinuationIndentWidth: 4

# --- Indentation / layout ---
AccessModifierOffset: -2
ConstructorInitializerIndentWidth: 4

# --- Disable alignment that breaks with tabs ---
AlignAfterOpenBracket: DontAlign
AlignOperands: false
AlignTrailingComments: false

# --- Function / brace style ---
AllowShortFunctionsOnASingleLine: InlineOnly
BreakBeforeBraces: Custom
BraceWrapping:
  AfterClass: true
  AfterFunction: true
  AfterNamespace: true
  AfterStruct: true

# --- Line width ---
ColumnLimit: 100

# --- Pointer style ---
DerivePointerAlignment: false
PointerAlignment: Middle

# --- Comments ---
ReflowComments: true

# --- Includes ---
IncludeCategories:
  # C++ system headers
  - Regex: <[a-z_]*>
    Priority: 6
    CaseSensitive: true
  # C system headers
  - Regex: <.*\.h>
    Priority: 5
    CaseSensitive: true
  # Boost headers
  - Regex: boost/.*
    Priority: 4
    CaseSensitive: true
  # Message headers
  - Regex: .*_msgs/.*
    Priority: 3
    CaseSensitive: true
  - Regex: .*_srvs/.*
    Priority: 3
    CaseSensitive: true
  # Other Package headers
  - Regex: <.*>
    Priority: 2
    CaseSensitive: true
  # Local package headers
  - Regex: '".*"'
    Priority: 1
    CaseSensitive: true