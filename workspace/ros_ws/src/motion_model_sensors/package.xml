<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>motion_model_sensors</name>
  <version>0.0.0</version>
  <description>SensorModel plugin implementations (lidar, ...).</description>
  <maintainer email="prajwalthakur98@gmail.com">Prajwal Thakur</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake_ros</buildtool_depend>

  <depend>project_utils</depend>
  <depend>motion_model_base</depend>
  <depend>pluginlib</depend>
  <depend>Eigen3</depend>
  <depend>eigen3_cmake_module</depend>
  <depend>yaml-cpp</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
